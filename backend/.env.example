APP_NAME=intelligent-cs-agent
ENVIRONMENT=dev
LOG_LEVEL=INFO

DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_LLM_MODEL=qwen-plus-latest
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

PG_DSN=postgresql+asyncpg://postgres:password@localhost:5432/ai_test
VECTOR_PERSIST_DIR=./data/chroma
VECTOR_COLLECTION=tjk_kb_docs
UPLOAD_DIR=./data/uploads
MAX_LLM_CONCURRENCY=5
TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
